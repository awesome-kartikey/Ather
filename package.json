{
  "name": "floor-trainer",
  "private": true,
  "version": "1.0.0",
  "description": "Floor Trainer - Ather Energy Warehouse Training PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:receiving": "tsc -b && vite build --mode receiving",
    "build:picking": "tsc -b && vite build --mode picking",
    "cap:sync": "cap sync android",
    "cap:sync:receiving": "tsx scripts/sync-android-mode.ts receiving && cap sync android",
    "cap:sync:picking": "tsx scripts/sync-android-mode.ts picking && cap sync android",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.1.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
